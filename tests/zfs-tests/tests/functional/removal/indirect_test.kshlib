# Locate the first mapped segment of a file block and count its splits.
# The tests remove vdev 0 onto vdev 1; offsets exclude front labels.
function indirect_test_locate # dataset object hexadecimal block size
{
	typeset dataset=$1 object=$2 expected=$3 dva offset src arrow dst rest
	typeset -i file_offset block_size start size
	log_must eval "zdb -dddddd '$dataset' '$object' >'$workdir/block'"
	dva=$(awk '$1 == "0" && $2 == "L0" { print $3 }' "$workdir/block")
	[[ $dva == 0:*:$expected ]] ||
	    log_fail "expected a $expected-byte block on removed vdev 0: $dva"
	offset=${dva#0:}
	file_offset="16#${offset%:*}"
	block_size="16#${offset##*:}"
	log_must eval "zdb -mmmm '$TESTPOOL1' >'$workdir/mapping'"
	segment_size=0
	splits=0
	while read -r src arrow dst rest; do
		[[ $src == '<0:'* && $arrow == '->' ]] || continue
		src=${src#'<0:'}
		src=${src%'>'}
		start="16#${src%:*}"
		size="16#${src#*:}"
		(( file_offset < start + size &&
		    start < file_offset + block_size )) || continue
		(( splits += 1 ))
		if (( file_offset >= start )); then
			[[ $dst == '<1:'* ]] ||
			    log_fail "unexpected mapping destination: $dst"
			dst=${dst#'<1:'}
			dst=${dst%'>'}
			disk_offset=$(( 16#${dst%:*} + file_offset - start ))
			segment_size=$(( size - (file_offset - start) ))
		fi
	done <"$workdir/mapping"
	(( segment_size > 0 )) || log_fail "first file segment is not mapped"
}

function indirect_leaf_sector
{
	# Allocated offsets follow the 4 MiB labels and boot reservation.
	echo $(( ($1 + 4194304) / 512 ))
}
